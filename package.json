{
  "name": "project-vault",
  "version": "0.1.0",
  "description": "Personal D&D campaign vault — Obsidian-style notes app",
  "main": "out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "npm run rebuild:electron && electron-vite build",
    "dist": "npm run build && electron-builder --mac --dir",
    "update-app": "bash scripts/update-app.sh",
    "test": "npm run rebuild:node && vitest run",
    "rebuild:electron": "node scripts/native-rebuild.mjs electron",
    "rebuild:node": "node scripts/native-rebuild.mjs node"
  },
  "build": {
    "appId": "com.projectvault.app",
    "productName": "Project Vault",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@supabase/supabase-js": "^2.110.8",
    "better-sqlite3": "^12.11.1",
    "buffer": "^6.0.3",
    "chokidar": "^5.0.0",
    "d3-force": "^3.0.0",
    "gray-matter": "^4.0.3",
    "nanoid": "^6.0.0",
    "process": "^0.11.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
