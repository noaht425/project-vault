{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@common/*": ["./src/common/*"]
    },
    "outDir": "./.ts-out/node"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/common/**/*",
    "electron.vite.config.ts",
    "tests/**/*"
  ]
}
